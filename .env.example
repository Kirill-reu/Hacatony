# Copy to .env (and load it however your run script does — e.g. `export $(cat .env | xargs)`,
# or python-dotenv if you add it) before running the server for a real demo.
# Every one of these has a working default, so the service runs with none of
# this set — see README "Running without any API keys".

# --- storage -------------------------------------------------------------
APP_DATA_DIR=./data

# --- generation limits -----------------------------------------------------
MAX_GENERATION_SECONDS=280
DEFAULT_SLIDE_COUNT=12
MIN_SLIDE_COUNT=6
MAX_SLIDE_COUNT=20
VARIANT_COUNT=3

# --- text LLM (any OpenAI-compatible /chat/completions endpoint) -----------
# VK inference gateway, a self-hosted Qwen/vLLM server, OpenAI itself, etc.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=qwen/qwen3.8-27b:free
LLM_TIMEOUT_SECONDS=60

# --- text-to-image (any OpenAI-compatible /images/generations endpoint) ----
# Open-weights, Apache-2.0/MIT, <=35B per the ТЗ (<=20B on the qualifying round).
IMAGE_BASE_URL=https://api.together.xyz/v1
IMAGE_API_KEY=key_CfJSDedcKmqe51VBRhyby
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell-Free

# --- web data provider (grounds generated facts/numbers; no key needed) ---
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5

# --- export ------------------------------------------------------------
# Needs LibreOffice installed on PATH (apt install libreoffice). If it's
# missing, PDF export is skipped (pptx/html still work) rather than failing the job.
SOFFICE_BINARY=soffice
PDF_EXPORT_ENABLED=true
PDF_EXPORT_TIMEOUT_SECONDS=60

# --- api -----------------------------------------------------------------
CORS_ORIGINS=*
